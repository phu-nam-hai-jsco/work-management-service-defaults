<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WorkManagement.ServiceDefaults — thư viện dùng chung cho các service của QuanLyCongViec:
    health checks (/health, /alive) và OpenTelemetry.
  -->

  <PropertyGroup>
    <RootNamespace>WorkManagement.ServiceDefaults</RootNamespace>
    <AssemblyName>WorkManagement.ServiceDefaults</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>WorkManagement.ServiceDefaults</PackageId>
    <Description>ServiceDefaults extensions for QuanLyCongViec: OpenTelemetry and default health check endpoints (/health, /alive).</Description>
    <PackageTags>servicedefaults;opentelemetry;healthchecks;quanlycongviec</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="WorkManagement.ServiceDefaults.Tests" />
  </ItemGroup>

</Project>
